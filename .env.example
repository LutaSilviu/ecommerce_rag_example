# Nexo Market local development configuration template.
# Copy to .env and replace placeholders on your machine. Never put live values here.

# Server-only settings. Never expose these values through frontend JavaScript.
DATABASE_URL=sqlite:///./data/nexo-market.db
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_COOKIE_NAME=nexo_session
SESSION_MAX_AGE_SECONDS=604800

# Use false only for local HTTP development. Set true for HTTPS environments.
SESSION_COOKIE_SECURE=false

# Google OAuth. The client ID is public by OAuth design, but both values are
# configured on the server; the client secret must remain private.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Canonical origin used to construct safe same-origin application redirects.
APP_BASE_URL=http://localhost:8000

# OpenAI product assistant. Add the real key to your ignored local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
